{"$schema":"/schemas/v2/regulation.schema.json","aliases":["HIPAA Privacy Rule","45 CFR 164 Subpart E"],"categories":[{"id":7,"name":"Database & Data Platforms","slug":"database-data-platforms","url":"https://example.invalid/static/app/monitoring_use_cases/category/database-data-platforms/","useCaseCount":1,"useCases":[{"criticality":"high","difficulty":"beginner","id":"UC-7.1.21","json":"https://example.invalid/static/app/monitoring_use_cases/uc/UC-7.1.21/index.json","shortId":"7.1.21","title":"Database User and Privilege Change Audit","url":"https://example.invalid/static/app/monitoring_use_cases/uc/UC-7.1.21/","value":"New users, role grants, or privilege changes can indicate compromise or policy violation. Auditing supports compliance (SOX, PCI) and security investigations."}]},{"id":11,"name":"Email & Collaboration","slug":"email-collaboration","url":"https://example.invalid/static/app/monitoring_use_cases/category/email-collaboration/","useCaseCount":2,"useCases":[{"criticality":"high","difficulty":"beginner","id":"UC-11.1.5","json":"https://example.invalid/static/app/monitoring_use_cases/uc/UC-11.1.5/index.json","shortId":"11.1.5","title":"SharePoint/OneDrive Sharing Audit","url":"https://example.invalid/static/app/monitoring_use_cases/uc/UC-11.1.5/","value":"External sharing can expose sensitive data. Audit trail ensures data protection and compliance."},{"criticality":"high","difficulty":"beginner","id":"UC-11.1.6","json":"https://example.invalid/static/app/monitoring_use_cases/uc/UC-11.1.6/index.json","shortId":"11.1.6","title":"DLP Policy Events","url":"https://example.invalid/static/app/monitoring_use_cases/uc/UC-11.1.6/","value":"M365 DLP policy matches across email, Teams, SharePoint identify sensitive data exposure. Centralized tracking supports compliance."}]},{"id":15,"name":"Data Center Physical Infrastructure","slug":"data-center-physical-infrastructure","url":"https://example.invalid/static/app/monitoring_use_cases/category/data-center-physical-infrastructure/","useCaseCount":1,"useCases":[{"criticality":"high","difficulty":"intermediate","id":"UC-15.3.37","json":"https://example.invalid/static/app/monitoring_use_cases/uc/UC-15.3.37/index.json","shortId":"15.3.37","title":"Access Control Event Audit","url":"https://example.invalid/static/app/monitoring_use_cases/uc/UC-15.3.37/","value":"Physical access logs correlate with logical access events for security investigation. Audit trail required for compliance."}]},{"id":22,"name":"Regulatory and Compliance Frameworks","slug":"regulatory-compliance","url":"https://example.invalid/static/app/monitoring_use_cases/category/regulatory-compliance/","useCaseCount":2,"useCases":[{"criticality":"high","difficulty":"intermediate","id":"UC-22.50.4","json":"https://example.invalid/static/app/monitoring_use_cases/uc/UC-22.50.4/index.json","shortId":"22.50.4","title":"§164.504(e) Business Associate activity — PHI access by BA principals","url":"https://example.invalid/static/app/monitoring_use_cases/uc/UC-22.50.4/","value":"HIPAA §164.504(e) requires BAAs; continuous verification that no BA accesses PHI outside a valid contract is primary evidence."},{"criticality":"medium","difficulty":"intermediate","id":"UC-22.50.16","json":"https://example.invalid/static/app/monitoring_use_cases/uc/UC-22.50.16/index.json","shortId":"22.50.16","title":"§164.528 accounting-of-disclosures — retention and responsiveness","url":"https://example.invalid/static/app/monitoring_use_cases/uc/UC-22.50.16/","value":"§164.528 requires the ability to produce an accounting of disclosures within 60 days; continuous metrics prevent nasty surprises during a HIPAA audit."}]}],"categoryCount":4,"generatedAt":"2026-04-21T07:24:26Z","html":"https://example.invalid/static/app/monitoring_use_cases/regulation/hipaa-privacy/","id":"hipaa-privacy","json":"https://example.invalid/static/app/monitoring_use_cases/regulation/hipaa-privacy/index.json","jurisdiction":["US"],"name":"HIPAA Privacy Rule","shortName":"HIPA